{
  "name": "headsup-mcp",
  "version": "1.5.5",
  "mcpName": "io.github.abhishek207/headsup-mcp",
  "description": "Spoken voice alerts on your Mac when Claude Code or Codex finishes a task or needs you.",
  "keywords": [
    "mcp",
    "claude-code",
    "codex",
    "plugin",
    "voice",
    "alerts",
    "notifications",
    "macos",
    "tts",
    "elevenlabs"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abhishek207/headsup-mcp.git"
  },
  "homepage": "https://github.com/abhishek207/headsup-mcp#readme",
  "author": {
    "name": "Brand Bakery",
    "url": "https://brandbakery.tech"
  },
  "type": "module",
  "license": "GPL-3.0-only",
  "os": [
    "darwin"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "headsup": "cli.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "build": "mkdir -p bin && swiftc -O tools/media-in-use.swift -o bin/media-in-use",
    "setup": "node tools/install.mjs",
    "validate": "claude plugin validate .",
    "settings": "node cli.mjs settings",
    "status": "node cli.mjs status",
    "voices:dry-run": "node tools/generate.mjs --dry-run"
  },
  "files": [
    ".claude-plugin/",
    ".codex-plugin/",
    "hooks/",
    "skills/",
    "assets/",
    "voices/",
    "tools/install.mjs",
    "tools/media-in-use.swift",
    "*.mjs",
    "settings.html",
    "templates.json",
    "voices.json",
    "README.md",
    "LICENSE"
  ],
  "contributors": [
    "Abhishek (https://github.com/abhishek207)"
  ],
  "bugs": {
    "url": "https://github.com/abhishek207/headsup-mcp/issues"
  }
}
