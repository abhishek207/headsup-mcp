{
  "name": "headsup-mcp",
  "version": "1.4.0",
  "description": "Spoken voice alerts on your Mac when Claude Code finishes a task or needs you.",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "os": ["darwin"],
  "engines": { "node": ">=20" },
  "bin": { "headsup": "cli.mjs" },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "build": "mkdir -p bin && swiftc -O tools/media-in-use.swift -o bin/media-in-use",
    "setup": "node tools/install.mjs",
    "settings": "node cli.mjs settings",
    "status": "node cli.mjs status",
    "voices:dry-run": "node tools/generate.mjs --dry-run"
  }
}
